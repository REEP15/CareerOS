rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - each user can only access their own subcollections
    match /users/{userId} {
      // User can read/write their own data
      allow read, write: if isOwner(userId);
      
      // All user-owned collections are nested under users/{userId}/
      
      // Settings collection
      match /settings/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // API Keys collection
      match /apiKeys/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Missions collection
      match /missions/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Jobs collection
      match /jobs/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Matches collection
      match /matches/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Resume collection
      match /resume/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Applications collection
      match /applications/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Tailored Resumes collection
      match /tailoredResumes/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Cover Letters collection
      match /coverLetters/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Notifications collection
      match /notifications/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Deny all other access to root-level collections (legacy paths)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
