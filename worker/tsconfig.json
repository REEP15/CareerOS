{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "declaration": false,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../shared/*"],
      "@/types/*": ["../shared/types/*"],
      "@/lib/*": ["../shared/lib/*"],
      "@/shared/*": ["../shared/*"],
      "@/services/*": ["services/*"],
      "@services/*": ["services/*"]
    },
    "outDir": "dist",
    "rootDir": ".."
  },
  "files": ["./index.ts"],
  "include": [
    "./services/**/*.ts",
    "./scripts/**/*.ts",
    "./**/*.ts",
    "../shared/lib/ai.ts",
    "../shared/lib/firebase.ts",
    "../shared/lib/utils.ts",
    "../shared/types/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "../app/**",
    "../components/**",
    "../lib/**",
    "../types/**",
    "../shared/lib/auth-fetch.ts",
    "../shared/lib/pdf-parse-wrapper.ts",
    "../shared/lib/server-auth.ts",
    "../shared/lib/utils.test.ts"
  ]
}
