{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["shared/*"],
      "@/shared/*": ["shared/*"],
      "@/services/*": ["services/*"],
      "@services/*": ["services/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "../shared/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
